# Contact form email delivery (Resend). Without these, the form tells visitors it is not connected.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Portfolio <contact@your-verified-domain.com>"
# Optional. Defaults to the email in src/data/profile.ts
CONTACT_TO_EMAIL=

# Public URL of the deployed site (used for canonical URLs, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://your-domain.com  # REQUIRED in production: production builds on Vercel fail without it

# Postgres connection string (Neon, Supabase, or any Postgres). Create the table with `npm run db:push`.
DATABASE_URL=

# Admin panel at /admin. Use a long random SESSION_SECRET (e.g. `openssl rand -base64 48`).
ADMIN_PASSWORD=
SESSION_SECRET=

# Contact form email delivery (Resend). Without these, the form tells visitors it is not connected.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Portfolio <contact@your-verified-domain.com>"
# Optional. Defaults to the email in src/data/profile.ts
CONTACT_TO_EMAIL=

# Public URL of the deployed site (used for canonical URLs, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
